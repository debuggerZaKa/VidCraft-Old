{
  "name": "vidcraft-root",
  "version": "1.0.0",
  "private": true,
  "description": "VidCraft multi-agent video generation pipeline",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./run-all.ps1",
    "start": "powershell -ExecutionPolicy Bypass -File ./run-all.ps1",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "ai-service": "ai-service\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir ai-service"
  }
}
