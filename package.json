{
  "name": "vidcraft",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "remotion"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:api": "npm run dev:api -w server",
    "dev:remotion": "npm run dev -w remotion",
    "build": "npm run build:client && npm run build:remotion",
    "build:client": "npm run build -w client",
    "build:remotion": "npm run build -w remotion",
    "lint": "npm run lint:client && npm run lint:server && npm run lint:remotion",
    "lint:client": "npm run lint -w client",
    "lint:server": "npm run lint -w server",
    "lint:remotion": "npm run lint -w remotion"
  }
}