# Hugging Face API token
HF_API_TOKEN=your_hf_api_token_here
VITE_PY_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:5000
PY_API_BASE_URL=http://localhost:8000

# Ref Image: caption with DashScope Qwen-VL first, then HF Featherless VLM fallback
HF_REF_CAPTION_BACKEND=auto
HF_REF_CAPTION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
HF_REF_CAPTION_PROVIDER=featherless-ai
HF_REF_CAPTION_MAX_SIDE=768
DASHSCOPE_VL_MODEL=qwen-vl-plus
HF_MODEL_IMG2IMG=black-forest-labs/FLUX.1-schnell
HF_IMG2IMG_PROVIDER=auto

DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Video Generator Configuration (Hugging Face Inference Providers)
HF_VIDEO_TOKEN=your_hf_video_token_here
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B
HF_VIDEO_PROVIDER=wavespeed
HF_VIDEO_SECONDS=2
HF_VIDEO_NUM_FRAMES=33
HF_VIDEO_INFERENCE_STEPS=20
FAL_API_KEY=your_fal_api_key_here

MONGODB_URI=mongodb://127.0.0.1:27017/vidcraft
JWT_SECRET=your_jwt_secret_here
